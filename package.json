{
  "name": "notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite --config macos/editor/vite.config.js build",
    "app": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild -project macos/Notes.xcodeproj -scheme Notes -destination 'platform=macOS' -derivedDataPath macos/.derived build && open macos/.derived/Build/Products/Debug/Notes.app"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bullet-list": "^3.34.0",
    "@tiptap/extension-paragraph": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "dompurify": "^3.4.18"
  },
  "devDependencies": {
    "vite": "^8.0.16"
  }
}
